
.course-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  transition: background-color 0.3s ease;
}

/* 深色模式 */
.course-container.dark-mode {
  background-color: #1a1a1a;
}

/* 顶部导航栏 */
.custom-navbar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}
.custom-navbar.dark-navbar {
  background-color: #2a2a2a;
  border-bottom-color: #3a3a3a;
}
.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  transition: color 0.3s ease;
}
.nav-title.dark-text {
  color: #fff;
}
.nav-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.search-icon {
  font-size: 40rpx;
  color: #333;
  transition: color 0.3s ease;
}
.search-icon.dark-icon {
  color: #fff;
}

/* 分类导航 - 可横向滚动 */
.category-scroll {
  height: 90rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  white-space: nowrap;
  transition: all 0.3s ease;
}
.category-scroll.dark-category-scroll {
  background-color: #2a2a2a;
  border-bottom-color: #3a3a3a;
}
.category-list {
  display: flex;
  flex-direction: row;
  padding: 0 20rpx;
}
.category-item {
  display: inline-block;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  flex-shrink: 0;
  transition: color 0.3s ease;
}
.category-item.dark-category-item {
  color: #aaa;
}
.category-item.active {
  color: #fb7299;
  font-weight: 500;
}
.category-item.dark-active {
  color: #ff85a9;
}
.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30rpx;
  right: 30rpx;
  height: 4rpx;
  background-color: #fb7299;
  border-radius: 2rpx;
}
.category-item.dark-active::after {
  background-color: #ff85a9;
}

/* 视频列表 - 两列优化 */
.video-list-scroll {
  height: calc(100vh - 180rpx);
}
.video-list {
  padding: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
.video-card {
  width: 48%;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 25rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  transition: all 0.3s ease;
}
.video-card.dark-card {
  background-color: #2a2a2a;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.video-card:active {
  transform: scale(0.98);
}
.video-cover {
  width: 100%;
  height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.video-cover::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.1) 0%, transparent 50%);
  pointer-events: none;
}
.cover-title {
  font-size: 44rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.2;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
  letter-spacing: 2rpx;
}
.cover-category {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(0, 0, 0, 0.25);
  padding: 6rpx 24rpx;
  border-radius: 40rpx;
  -webkit-backdrop-filter: blur(4px);
          backdrop-filter: blur(4px);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}
.video-info {
  padding: 20rpx 16rpx;
}
.video-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  lines: 2;
  text-overflow: ellipsis;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  transition: color 0.3s ease;
}
.video-title.dark-title {
  color: #fff;
}
.video-meta {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #888;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 12rpx;
  transition: all 0.3s ease;
}
.video-meta.dark-meta {
  color: #aaa;
  border-top-color: #3a3a3a;
}
.video-author {
  flex: 1;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  color: #666;
  transition: color 0.3s ease;
}
.video-author.dark-author {
  color: #aaa;
}
.video-play {
  color: #999;
  margin-left: 10rpx;
  transition: color 0.3s ease;
}
.video-play.dark-play {
  color: #aaa;
}
.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: #999;
  transition: color 0.3s ease;
}
.load-more.dark-load-text {
  color: #666;
}
.dev-info {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #ccc;
  transition: color 0.3s ease;
}
.dev-info.dark-dev {
  color: #666;
}
